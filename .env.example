# ============================================
#   ПРИМЕР КОНФИГУРАЦИИ
# ============================================
#   1. Скопируй этот файл в .env
#      cp .env.example .env
#   2. Заполни своими значениями
#   3. НИКОГДА не коммить .env в git
# ============================================

# ============================================
#   Telegram API
# ============================================
# Получить: https://my.telegram.org → API development tools
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+79991234567

# ============================================
#   Прокси (опционально)
# ============================================
# Тип: socks5 | http | mtproto | (пусто = без прокси)
PROXY_TYPE=

# --- SOCKS5 / HTTP ---
# Пример: приватный SOCKS5 в Казахстане
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_RDNS=true

# --- MTProto ---
# Только если PROXY_TYPE=mtproto
PROXY_SECRET=

# ============================================
#   Kev-сервер
# ============================================
KEV_BASE_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest

# ============================================
#   Flask (веб-интерфейс)
# ============================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================
#   Логика бота
# ============================================
MESSAGE_TIMEOUT=5
MAX_MESSAGES=500
RESTART_INTERVAL=600